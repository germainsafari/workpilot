# The UI uses its same-origin demo API when this is blank.
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8000

# Local FastAPI settings. Docker Compose supplies these automatically.
WORKPILOT_ENVIRONMENT=local
# Local Postgres:
WORKPILOT_DATABASE_URL=postgresql+asyncpg://workpilot:workpilot-local@localhost:5432/workpilot
# Managed Postgres (Neon/RDS/Supabase): libpq params like sslmode and
# channel_binding are handled automatically by app/db.py, e.g.
# WORKPILOT_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
WORKPILOT_REDIS_URL=redis://localhost:6379/0
WORKPILOT_AUTO_CREATE_SCHEMA=true
WORKPILOT_SEED_DEMO_DATA=true
WORKPILOT_EXECUTE_RUNS_INLINE=true
WORKPILOT_LOCAL_AUTH_ENABLED=true
WORKPILOT_JWT_SECRET=replace-for-any-shared-environment
WORKPILOT_CORS_ORIGINS=http://localhost:3000

# ============================================================================
# WorkPilot — environment template. Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# One file, every target:
#   • Web frontend (Next/vinext, Vercel, Cloudflare)  -> NEXT_PUBLIC_* vars
#   • API + worker (FastAPI, Docker, ECS)             -> WORKPILOT_* vars
#   • Docker Compose                                  -> POSTGRES_* vars
# For Vercel/Amplify you only need the NEXT_PUBLIC_* block.
# ============================================================================

# ─── WEB FRONTEND (public — safe to expose to the browser) ──────────────────
# API base URL the UI calls (NO trailing slash). Local Docker => http://localhost:8000
#NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:8000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://workpilot-staging-alb-124399340.eu-central-1.elb.amazonaws.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=eu-central-1
NEXT_PUBLIC_DEMO_EMAIL=

# Staging ALB URL (only when pointing the web UI at AWS)
NEXT_PUBLIC_CONTROL_PLANE_URL_STAGING=

# ─── STAGING LOGIN (local reference — never commit real passwords) ──────────
DEMO_COGNITO_EMAIL=
DEMO_COGNITO_PASSWORD=
COGNITO_TEMP_PASSWORD=

# ─── DOCKER / POSTGRES ──────────────────────────────────────────────────────
POSTGRES_DB=workpilot
POSTGRES_USER=workpilot
POSTGRES_PASSWORD=change-me

# ─── API + WORKER (server-only — never sent to the browser) ─────────────────
WORKPILOT_ENVIRONMENT=local
WORKPILOT_DATABASE_URL=postgresql+asyncpg://workpilot:change-me@localhost:5432/workpilot
WORKPILOT_REDIS_URL=redis://localhost:6379/0
WORKPILOT_AUTO_CREATE_SCHEMA=true
WORKPILOT_SEED_DEMO_DATA=true
WORKPILOT_EXECUTE_RUNS_INLINE=true
WORKPILOT_LOCAL_AUTH_ENABLED=true
WORKPILOT_JWT_SECRET=replace-for-any-shared-environment
WORKPILOT_COGNITO_USER_POOL_ID=
WORKPILOT_COGNITO_APP_CLIENT_ID=
WORKPILOT_COGNITO_REGION=eu-central-1
WORKPILOT_AGENT_RUNTIME=deterministic_mock
WORKPILOT_BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
WORKPILOT_BEDROCK_REGION=eu-central-1
WORKPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WORKPILOT_OTEL_ENABLED=false

# ─── CLOUDFLARE (Workers deploy) ─────────────────────────────────────────────
# Only needed for self-contained D1 demo mode. Leave empty when the UI calls AWS.
# Create with: npx wrangler d1 create workpilot
CLOUDFLARE_D1_DATABASE_ID=

# ─── AWS INFRA (CLI / Terraform — optional, for deploy scripts) ───────────────
AWS_ACCOUNT_ID=
AWS_IAM_USER=
TF_STATE_BUCKET=
ECR_REPOSITORY=
